{
  "name": "auto-rebalancer",
  "version": "1.0.0",
  "description": "AutoRebalancer smart contract and AI executor dApp for BOT Chain",
  "main": "server.js",
  "scripts": {
    "postinstall": "npm --prefix Autorebalncer-Frontend install",
    "start": "node server.js",
    "build": "npm --prefix Autorebalncer-Frontend install && npm --prefix Autorebalncer-Frontend run build",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.js --network botTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network botMainnet",
    "dev:frontend": "npm --prefix Autorebalncer-Frontend run dev",
    "build:frontend": "npm --prefix Autorebalncer-Frontend run build",
    "typecheck:frontend": "npm --prefix Autorebalncer-Frontend run typecheck"
  },
  "keywords": [
    "hardhat",
    "solidity",
    "autorebalancer",
    "bot-chain",
    "smart-contract",
    "ai-agent",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2"
  }
}