# AutoRebalancer Backend Environment Configuration (Template)
# Copy to .env and fill in your private keys and API keys

# Hardhat Deployer Private Key (without 0x prefix or with 0x prefix)
PRIVATE_KEY=your_deployer_private_key_here

# Off-chain Executor Wallet Private Key (authorized to call executeRebalance)
EXECUTOR_PRIVATE_KEY=your_executor_private_key_here

# Google Gemini AI API Key (for portfolio analysis & rebalance decision engine)
GEMINI_API_KEY=your_gemini_api_key_here

# BOT Chain Network Configuration (Default: BOT Chain Mainnet Chain ID 677)
RPC_URL=https://rpc.botchain.ai
CONTRACT_ADDRESS=0x1672fBF0E2322e8662D2242C1aC10DAB37D11223
TOKEN_A_ADDRESS=0x546307af427902A75771434Df831d88219784E19
TOKEN_B_ADDRESS=0xef8DC669ECa13E612b67Ff09478352E85bD6CC53
DEX_ROUTER_ADDRESS=0x143b0Cf8A34B7bFD794d64e0E565155f0904902B

# Server Settings
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
