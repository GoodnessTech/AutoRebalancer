{
  "framework": "vite",
  "installCommand": "npm --prefix Autorebalncer-Frontend install",
  "buildCommand": "npm --prefix Autorebalncer-Frontend run build",
  "outputDirectory": "Autorebalncer-Frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
